<%- include("../partials/head") %>
<%- include("../partials/navbar", { activePage: "orders" }) %>

<main class="orders-page page-container" style="padding:3rem 1rem;max-width:900px;margin:0 auto;">
  <h1 style="font-family:var(--font-display);margin-bottom:1.5rem;"><%= t('my_orders') %></h1>

  <% if (!orders.length) { %>
    <p class="admin-empty">You haven't placed any orders yet. <a href="/shop">Start shopping</a>.</p>
  <% } else { %>
    <div class="orders-list" style="display:flex;flex-direction:column;gap:1rem;">
      <% orders.forEach(function(o) { %>
        <div class="order-card" style="border:1px solid #eee;border-radius:10px;padding:1.25rem 1.5rem;">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem;">
            <div>
              <strong>Order #<%= String(o._id).slice(-6).toUpperCase() %></strong>
              <span style="color:#888;font-size:.85rem;margin-left:.5rem;"><%= new Date(o.createdAt).toLocaleDateString() %></span>
            </div>
            <span class="admin-badge admin-badge--<%= o.status %>"><%= o.status %></span>
          </div>
          <ul style="margin:.75rem 0;padding:0;list-style:none;font-size:.9rem;color:#555;">
            <% o.lineItems.forEach(function(li) { %>
              <li><%= li.quantity %> × <%= li.name %> (<%= li.size %>) — <%= li.price %> <%= li.currency %></li>
            <% }) %>
          </ul>
          <div style="font-weight:700;text-align:right;">Total: <%= o.totalPrice %> LE</div>
        </div>
      <% }) %>
    </div>
    <%- include("../partials/pagination", { page, pages }) %>
  <% } %>
</main>

<%- include("../partials/footer") %>
